rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Patients collection
    match /patients/{patientId} {
      // Allow create if auth matches, but for Phase 3 we also want the patient device 
      // (which may technically still hold the doctor's auth session) to read its own reminders.
      // Since MVP uses the doctor's session bound to the device, the old rules work.
      allow create: if request.auth != null && request.resource.data.createdByDoctorId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.createdByDoctorId == request.auth.uid;
      
      // Phase 2: Consultations sub-collection
      match /consultations/{consultationId} {
        allow create: if request.auth != null && request.resource.data.doctorId == request.auth.uid;
        allow read, update, delete: if request.auth != null && resource.data.doctorId == request.auth.uid;
      }
      
      // Phase 3: Reminders sub-collection
      match /reminders/{reminderId} {
        allow create, read, update, delete: if request.auth != null;
      }
    }
  }
}
